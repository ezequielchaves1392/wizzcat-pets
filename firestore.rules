// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para el perfil de la mascota
    match /pets/{userId} {
      allow read: if request.auth != null;
      // Solo el dueño puede actualizar, y se valida que no altere su nivel o recursos de forma fraudulenta
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para el Chat Global
    match /global_chat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && request.resource.data.text is string 
                    && request.resource.data.text.size() <= 256;
    }

    // Reglas para el Mercado P2P
    match /market_listings/{listingId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null;
    }
  }
}